    <!-- 指南 -->
    <string name="guide_tab_installation">安装</string>
    <string name="guide_tab_usage">使用</string>
    <string name="guide_tab_features">功能</string>
    <string name="guide_title">Big MFA 指南</string>
    <string name="guide_intro">所有可用功能的快速概览。</string>
    <string name="guide_codes_title">🔑 我的验证码</string>
    <string name="guide_codes_body">您的 TOTP 验证码会实时刷新，并带有可视化倒计时。点击验证码即可复制（30 秒后自动从剪贴板清除）。对于 HOTP 账户，每次需要验证码时点击“生成”。使用每行的图标可以搜索、重命名或删除账户。</string>
    <string name="guide_decoder_title">🔍 解码器</string>
    <string name="guide_decoder_body">从二维码图片粘贴或导入密钥，即可立即获取对应的 TOTP 验证码，而无需将其添加到保险库中。适用于一次性验证。</string>
    <string name="guide_key_title">🔐 密钥</string>
    <string name="guide_key_body">生成一个随机密钥及其对应的二维码，用于在要求您创建自己密钥的其他服务中设置新账户。</string>
    <string name="guide_add_title">➕ 添加账户</string>
    <string name="guide_add_body">扫描服务提供的二维码，或手动输入密钥。高级选项允许您调整算法、位数、周期，或切换为 HOTP。</string>
    <string name="guide_biometric_title">👆 生物识别解锁</string>
    <string name="guide_biometric_body">在设置中启用指纹解锁。您的主密码始终作为备用方式保留 — 永远不会被替代，只会被补充。</string>
    <string name="guide_backup_title">💾 备份与恢复</string>
    <string name="guide_backup_body">两种导出格式：最高安全性（Android 原生）或跨平台兼容（可导入 Chrome 扩展程序）。二维码导出会生成一个二维码轮播，可以单独导出或打包为 ZIP 压缩包。恢复时会自动检测文件格式。</string>
    <string name="guide_security_title">🛡 安全</string>
    <string name="guide_security_body">所有数据仅保留在您的设备上，使用 AES-256-GCM-SIV 加密，密钥通过 Argon2id 派生。应用本身从不发起任何网络连接。</string>
    <string name="guide_language_title">🌐 语言</string>
    <string name="guide_language_body">选择“自动”以跟随您手机的语言，或在登录屏幕的页脚中选择特定语言。</string>
    <string name="guide_install_step1_title">1. 创建您的保险库</string>
    <string name="guide_install_step1_body">首次启动时，选择“创建保险库”以空保险库开始，或者如果您已在 Chrome 或其他 Android 设备上使用过 Big MFA，选择“恢复现有备份”。</string>
    <string name="guide_install_step2_title">2. 选择一个强主密码</string>
    <string name="guide_install_step2_body">最少 12 个字符，但更推荐使用 16 位以上的密码短语（例如多个词组合而成）。这是保护您所有账户的唯一密钥。</string>
    <string name="guide_install_step3_title">3. 了解其不可恢复性</string>
    <string name="guide_install_step3_body">Big MFA 不会以明文或加密形式在任何地方存储您的主密码。如果您忘记了密码且没有外部备份，您的账户将永久无法访问。请将其记录在可靠的密码管理器中。</string>
    <string name="guide_install_step4_title">4. 启用生物识别（可选）</string>
    <string name="guide_install_step4_body">在设置中启用指纹解锁，以便更快地进行日常访问。您的主密码始终作为备用方式保留。</string>
    <string name="guide_usage_step1_title">1. 添加您的第一个账户</string>
    <string name="guide_usage_step1_body">在“+ 添加”中，扫描服务显示的二维码（最快方法），或者如果无法扫描，请手动输入名称、发行方和 Base32 密钥。</string>
    <string name="guide_usage_step2_title">2. 每天使用验证码</string>
    <string name="guide_usage_step2_body">在“我的验证码”中，直接点击 TOTP 验证码即可复制（30 秒后自动从剪贴板清除）。对于 HOTP 账户，每次需要时点击“生成”— 计数器始终向前推进，绝不会后退。</string>
    <string name="guide_usage_step3_title">3. 管理您的账户</string>
    <string name="guide_usage_step3_body">使用搜索栏在多个账户中快速找到需要的账户。铅笔图标可用于重命名，垃圾桶图标可用于删除（需二次确认，操作不可撤销）。</string>
    <string name="guide_usage_step4_title">4. 定期备份</string>
    <string name="guide_usage_step4_body">在设置中，选择“最高安全性导出”以创建仅限 Android 的备份，或者如果您在 Chrome 中也使用 Big MFA，选择“跨平台兼容导出”。二维码导出（轮播或 ZIP）适用于迁移到其他标准 TOTP 兼容的管理器。</string>
    <string name="guide_usage_step5_title">5. 更改您的主密码</string>
    <string name="guide_usage_step5_body">在设置中输入当前密码，然后输入新密码。您的账户和生物识别设置（如已启用）将保持不变 — 仅密码会发生更改。</string>
