    <string name="guide_tab_usage">Anvendelse</string>
    <string name="guide_tab_features">Funktioner</string>
    <string name="guide_title">Big MFA-guide</string>
    <string name="guide_intro">Et hurtigt overblik over alle tilgængelige funktioner.</string>
    <string name="guide_codes_title">🔑 Mine koder</string>
    <string name="guide_codes_body">Dine TOTP-koder opdateres i realtid med en visuel nedtælling. Tryk på en kode for at kopiere den (slettes automatisk fra udklipsholderen efter 30s). For HOTP-konti, tryk på “Generer”, hver gang du har brug for en. Søg, omdøb eller slet en konto med ikonerne på hver linje.</string>
    <string name="guide_decoder_title">🔍 Dekoder</string>
    <string name="guide_decoder_body">Indsæt eller importer en hemmelighed fra et QR-kodebillede for straks at få dens TOTP-kode uden at tilføje den til din boks. Nyttigt til en engangskontrol.</string>
    <string name="guide_key_title">🔐 Nøgle</string>
    <string name="guide_key_body">Genererer en tilfældig hemmelighedsnøgle med tilhørende QR-kode til at konfigurere en ny konto hos en anden tjeneste, der beder dig oprette din egen hemmelighed.</string>
    <string name="guide_add_title">➕ Tilføj en konto</string>
    <string name="guide_add_body">Scan den QR-kode, tjenesten viser, eller indtast hemmeligheden manuelt. De avancerede indstillinger giver dig mulighed for at justere algoritmen, antallet af cifre, perioden, eller skifte til HOTP.</string>
    <string name="guide_biometric_title">👆 Biometrisk oplåsning</string>
    <string name="guide_biometric_body">Aktivér oplåsning med fingeraftryk i Indstillinger. Din hovedadgangskode forbliver altid tilgængelig som reserve — aldrig erstattet, kun suppleret.</string>
    <string name="guide_backup_title">💾 Sikkerhedskopiering og gendannelse</string>
    <string name="guide_backup_body">To eksportformater: maksimal sikkerhed (nativt til Android) eller platformuafhængigt kompatibelt (kan importeres i Chrome-udvidelsen). QR-eksporten genererer en karrusel af QR-koder, enkeltvis eller som ZIP-arkiv. Gendannelse registrerer automatisk filformatet.</string>
    <string name="guide_security_title">🛡 Sikkerhed</string>
    <string name="guide_security_body">Alle data forbliver udelukkende på din enhed, krypteret med AES-256-GCM-SIV og en nøgle udledt med Argon2id. Appen opretter aldrig selv en netværksforbindelse.</string>
    <string name="guide_language_title">🌐 Sprog</string>
    <string name="guide_language_body">Vælg “Automatisk” for at følge din telefons sprog, eller vælg et bestemt sprog i sidefoden på loginskærmene.</string>
    <string name="guide_install_step1_title">1. Opret din boks</string>
    <string name="guide_install_step1_body">Ved første start, vælg “Opret boks” for at starte med en tom boks, eller “Gendan en eksisterende sikkerhedskopi”, hvis du allerede har brugt Big MFA i Chrome eller på en anden Android-enhed.</string>
    <string name="guide_install_step2_title">2. Vælg en stærk hovedadgangskode</string>
    <string name="guide_install_step2_body">Minimum 12 tegn, men sigt hellere efter en adgangssætning på 16+ tegn (for eksempel flere kombinerede ord). Det er den eneste nøgle, der beskytter alle dine konti.</string>
    <string name="guide_install_step3_title">3. Forstå at det ikke kan gendannes</string>
    <string name="guide_install_step3_body">Big MFA gemmer ikke din hovedadgangskode nogen steder, hverken i klartekst eller krypteret. Hvis du glemmer den og ikke har en ekstern sikkerhedskopi, bliver dine konti permanent utilgængelige. Skriv den ned i en pålidelig adgangskodeadministrator.</string>
    <string name="guide_install_step4_title">4. Aktivér biometri (valgfrit)</string>
    <string name="guide_install_step4_body">Aktivér oplåsning med fingeraftryk i Indstillinger for hurtigere daglig adgang. Din hovedadgangskode forbliver altid tilgængelig som reserve.</string>
    <string name="guide_usage_step1_title">1. Tilføj din første konto</string>
    <string name="guide_usage_step1_body">Under “+ Tilføj”, scan den QR-kode, tjenesten viser (hurtigste metode), eller indtast manuelt navn, udsteder og Base32-hemmelighed, hvis du ikke kan scanne.</string>
    <string name="guide_usage_step2_title">2. Brug en kode dagligt</string>
    <string name="guide_usage_step2_body">Under “Mine koder”, tryk direkte på en TOTP-kode for at kopiere den (slettes automatisk fra udklipsholderen efter 30 sekunder). For en HOTP-konto, tryk på “Generer”, hver gang du har brug for en — tælleren bevæger sig altid fremad, aldrig baglæns.</string>
    <string name="guide_usage_step3_title">3. Administrer dine konti</string>
    <string name="guide_usage_step3_body">Brug søgefeltet til hurtigt at finde en konto blandt flere. Blyantikonet lader dig omdøbe, papirkurvsikonet lader dig slette (med dobbelt bekræftelse, en handling der ikke kan fortrydes).</string>
    <string name="guide_usage_step4_title">4. Tag sikkerhedskopier regelmæssigt</string>
    <string name="guide_usage_step4_body">Vælg “Eksport med maksimal sikkerhed” i Indstillinger for en ren Android-sikkerhedskopi, eller “Platformuafhængig eksport”, hvis du også bruger Big MFA i Chrome. QR-eksporten (karrusel eller ZIP) er nyttig til at overføre til en anden standard TOTP-kompatibel administrator.</string>
    <string name="guide_usage_step5_title">5. Skift din hovedadgangskode</string>
    <string name="guide_usage_step5_body">Indtast din nuværende adgangskode i Indstillinger og derefter den nye. Dine konti og din biometri (hvis aktiveret) forbliver intakte — kun adgangskoden ændres.</string>
