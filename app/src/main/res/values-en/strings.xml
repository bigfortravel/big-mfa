    <!-- Guide -->
    <string name="guide_title">Big MFA Guide</string>
    <string name="guide_intro">A quick overview of every available feature.</string>

    <string name="guide_codes_title">🔑 My codes</string>
    <string name="guide_codes_body">Your TOTP codes refresh live with a visual countdown. Tap a code to copy it (automatically cleared from the clipboard after 30s). For HOTP accounts, tap "Generate" each time you need a code. Search, rename, or delete an account using the icons on each row.</string>

    <string name="guide_decoder_title">🔍 Decoder</string>
    <string name="guide_decoder_body">Paste or import a secret from a QR code image to instantly get its TOTP code, without adding it to your vault. Useful for a one-time check.</string>

    <string name="guide_key_title">🔐 Key</string>
    <string name="guide_key_body">Generates a random secret key, with its QR code, to set up a new account on another service that asks you to create your own secret.</string>

    <string name="guide_add_title">➕ Add an account</string>
    <string name="guide_add_body">Scan the QR code provided by the service, or manually enter the secret. Advanced options let you adjust the algorithm, number of digits, period, or switch to HOTP.</string>

    <string name="guide_biometric_title">👆 Biometric unlock</string>
    <string name="guide_biometric_body">Enable fingerprint unlock from Settings. Your master password always remains available as a fallback — never replaced, only complemented.</string>

    <string name="guide_backup_title">💾 Backup and restore</string>
    <string name="guide_backup_body">Two export formats: maximum security (native Android) or cross-platform compatible (importable into the Chrome extension). QR export generates a carousel of QR codes, individually or as a ZIP archive. Restoring automatically detects the file format.</string>

    <string name="guide_security_title">🛡 Security</string>
    <string name="guide_security_body">All data stays exclusively on your device, encrypted with AES-256-GCM-SIV and a key derived using Argon2id. No network connection is ever initiated by the app itself.</string>

    <string name="guide_language_title">🌐 Language</string>
    <string name="guide_language_body">Choose "Automatic" to follow your phone\'s language, or select a specific language from the footer of the login screens.</string>
    <!-- Guide - tabs -->
    <string name="guide_tab_installation">Installation</string>
    <string name="guide_tab_usage">Usage</string>
    <string name="guide_tab_features">Features</string>

    <!-- Installation guide -->
    <string name="guide_install_step1_title">1. Create your vault</string>
    <string name="guide_install_step1_body">On first launch, choose "Create vault" to start with an empty vault, or "Restore an existing backup" if you\'ve already used Big MFA on Chrome or another Android device.</string>

    <string name="guide_install_step2_title">2. Choose a strong master password</string>
    <string name="guide_install_step2_body">Minimum 12 characters, but aim for a 16+ character passphrase (for example, several words combined). It\'s the only key protecting all your accounts.</string>

    <string name="guide_install_step3_title">3. Understand it\'s unrecoverable</string>
    <string name="guide_install_step3_body">Big MFA does not store your master password anywhere, neither in plain text nor encrypted. If you forget it and have no external backup, your accounts will be permanently inaccessible. Write it down in a reliable password manager.</string>

    <string name="guide_install_step4_title">4. Enable biometrics (optional)</string>
    <string name="guide_install_step4_body">From Settings, enable fingerprint unlock for faster daily access. Your master password always remains available as a fallback.</string>
    <!-- Usage guide -->
    <string name="guide_usage_step1_title">1. Add your first account</string>
    <string name="guide_usage_step1_body">From "+ Add", scan the QR code shown by the service (fastest method), or manually enter the name, issuer, and Base32 secret if you cannot scan.</string>

    <string name="guide_usage_step2_title">2. Use a code daily</string>
    <string name="guide_usage_step2_body">On "My codes", tap directly on a TOTP code to copy it (automatically cleared from the clipboard after 30 seconds). For an HOTP account, tap "Generate" each time you need one — the counter always moves forward, never back.</string>

    <string name="guide_usage_step3_title">3. Manage your accounts</string>
    <string name="guide_usage_step3_body">Use the search bar to quickly find an account among many. The pencil icon lets you rename, the trash icon lets you delete (with double confirmation, irreversible action).</string>

    <string name="guide_usage_step4_title">4. Back up regularly</string>
    <string name="guide_usage_step4_body">From Settings, choose "Maximum security export" for an Android-only backup, or "Cross-platform compatible export" if you also use Big MFA on Chrome. QR export (carousel or ZIP) is useful for transferring to another standard TOTP-compatible manager.</string>

    <string name="guide_usage_step5_title">5. Change your master password</string>
    <string name="guide_usage_step5_body">From Settings, enter your current password then the new one. Your accounts and biometrics (if enabled) remain intact — only the password changes.</string>
