    <string name="guide_autofill_title">🔐 Autofill</string>
    <string name="guide_autofill_body">Big MFA can offer your codes directly in other apps and websites, after biometric verification. Enable it in Settings, then link each account to its app or site by editing the account (pencil icon). Domain verification protects against phishing: only real browsers can report a trusted domain.</string>
    <string name="guide_google_import_title">📲 Google Authenticator import</string>
    <string name="guide_google_import_body">Scan or import Google Authenticator\'s export directly (its "Transfer accounts" menu): Big MFA automatically detects this format and lets you select which accounts to import at once, instead of adding them one by one.</string>
