    <!-- מדריך -->
    <string name="guide_tab_installation">התקנה</string>
    <string name="guide_tab_usage">שימוש</string>
    <string name="guide_tab_features">תכונות</string>
    <string name="guide_title">מדריך Big MFA</string>
    <string name="guide_intro">סקירה מהירה של כל התכונות הזמינות.</string>
    <string name="guide_codes_title">🔑 הקודים שלי</string>
    <string name="guide_codes_body">קודי ה-TOTP שלך מתעדכנים בזמן אמת עם ספירה לאחור חזותית. הקש על קוד כדי להעתיק אותו (נמחק אוטומטית מהלוח בעוד 30 שניות). עבור חשבונות HOTP, הקש על „צור” בכל פעם שאתה צריך קוד. חפש, שנה שם או מחק חשבון באמצעות הסמלים בכל שורה.</string>
    <string name="guide_decoder_title">🔍 מפענח</string>
    <string name="guide_decoder_body">הדבק או ייבא סוד מתמונת קוד QR כדי לקבל מיד את קוד ה-TOTP המתאים, מבלי להוסיף אותו לכספת שלך. שימושי לבדיקה חד-פעמית.</string>
    <string name="guide_key_title">🔐 מפתח</string>
    <string name="guide_key_body">יוצר מפתח סודי אקראי, יחד עם קוד ה-QR המתאים, כדי להגדיר חשבון חדש בשירות אחר שמבקש ממך ליצור סוד משלך.</string>
    <string name="guide_add_title">➕ הוספת חשבון</string>
    <string name="guide_add_body">סרוק את קוד ה-QR שסופק על ידי השירות, או הזן את הסוד ידנית. האפשרויות המתקדמות מאפשרות לך להתאים את האלגוריתם, מספר הספרות, התקופה, או לעבור ל-HOTP.</string>
    <string name="guide_biometric_title">👆 ביטול נעילה ביומטרי</string>
    <string name="guide_biometric_body">הפעל ביטול נעילה באמצעות טביעת אצבע מתוך ההגדרות. הסיסמה הראשית שלך תמיד נשארת זמינה כגיבוי — לעולם לא מוחלפת, רק משלימה.</string>
    <string name="guide_backup_title">💾 גיבוי ושחזור</string>
    <string name="guide_backup_body">שני פורמטים לייצוא: אבטחה מרבית (מקורי ל-Android) או תואם רב-פלטפורמות (ניתן לייבוא לתוסף Chrome). ייצוא QR יוצר קרוסלה של קודי QR, בנפרד או בארכיון ZIP. השחזור מזהה את פורמט הקובץ אוטומטית.</string>
    <string name="guide_security_title">🛡 אבטחה</string>
    <string name="guide_security_body">כל הנתונים נשארים באופן בלעדי במכשיר שלך, מוצפנים באמצעות AES-256-GCM-SIV ומפתח שנגזר באמצעות Argon2id. האפליקציה לעולם אינה יוזמת חיבור רשת בעצמה.</string>
    <string name="guide_language_title">🌐 שפה</string>
    <string name="guide_language_body">בחר „אוטומטי” כדי לעקוב אחר שפת הטלפון שלך, או בחר שפה ספציפית מתחתית מסכי ההתחברות.</string>
    <string name="guide_install_step1_title">1. צור את הכספת שלך</string>
    <string name="guide_install_step1_body">בהפעלה הראשונה, בחר „צור כספת” כדי להתחיל עם כספת ריקה, או „שחזר גיבוי קיים” אם כבר השתמשת ב-Big MFA ב-Chrome או במכשיר Android אחר.</string>
    <string name="guide_install_step2_title">2. בחר סיסמה ראשית חזקה</string>
    <string name="guide_install_step2_body">מינימום 12 תווים, אך עדיף לכוון לביטוי סיסמה בן 16+ תווים (למשל, כמה מילים משולבות). זהו המפתח היחיד המגן על כל החשבונות שלך.</string>
    <string name="guide_install_step3_title">3. הבן את חוסר האפשרות לשחזר</string>
    <string name="guide_install_step3_body">Big MFA אינה מאחסנת את הסיסמה הראשית שלך בשום מקום, לא כטקסט רגיל ולא מוצפנת. אם תשכח אותה ואין לך גיבוי חיצוני, החשבונות שלך יהפכו לבלתי נגישים לצמיתות. רשום אותה במנהל סיסמאות אמין.</string>
    <string name="guide_install_step4_title">4. הפעל ביומטריה (אופציונלי)</string>
    <string name="guide_install_step4_body">מתוך ההגדרות, הפעל ביטול נעילה באמצעות טביעת אצבע לגישה יומיומית מהירה יותר. הסיסמה הראשית שלך תמיד נשארת זמינה כגיבוי.</string>
    <string name="guide_usage_step1_title">1. הוסף את החשבון הראשון שלך</string>
    <string name="guide_usage_step1_body">מתוך „+ הוסף”, סרוק את קוד ה-QR המוצג על ידי השירות (השיטה המהירה ביותר), או הזן ידנית את השם, המנפיק והסוד ב-Base32 אם אינך יכול לסרוק.</string>
    <string name="guide_usage_step2_title">2. השתמש בקוד מדי יום</string>
    <string name="guide_usage_step2_body">ב-„הקודים שלי”, הקש ישירות על קוד TOTP כדי להעתיק אותו (נמחק אוטומטית מהלוח בעוד 30 שניות). עבור חשבון HOTP, הקש על „צור” בכל פעם שאתה צריך אותו — המונה תמיד מתקדם, לעולם אינו חוזר אחורה.</string>
    <string name="guide_usage_step3_title">3. נהל את החשבונות שלך</string>
    <string name="guide_usage_step3_body">השתמש בשורת החיפוש כדי למצוא במהירות חשבון מבין רבים. סמל העיפרון מאפשר שינוי שם, סמל פח האשפה מאפשר מחיקה (עם אישור כפול, פעולה בלתי הפיכה).</string>
    <string name="guide_usage_step4_title">4. גבה באופן קבוע</string>
    <string name="guide_usage_step4_body">מתוך ההגדרות, בחר „ייצוא באבטחה מרבית” לגיבוי ייעודי ל-Android בלבד, או „ייצוא תואם רב-פלטפורמות” אם אתה משתמש ב-Big MFA גם ב-Chrome. ייצוא QR (קרוסלה או ZIP) שימושי להעברה למנהל סטנדרטי אחר התואם ל-TOTP.</string>
    <string name="guide_usage_step5_title">5. שנה את הסיסמה הראשית שלך</string>
    <string name="guide_usage_step5_body">בהגדרות, הזן את הסיסמה הנוכחית שלך, ולאחר מכן את החדשה. החשבונות והביומטריה שלך (אם מופעלת) נשארים ללא שינוי — רק הסיסמה משתנה.</string>
